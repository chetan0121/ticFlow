# Port on which the server listens
PORT=3000

# Development mode (true/false); when true, all frontend origins are allowed
DEV_MODE=true

# Required when DEV_MODE is false; comma-separated frontend URLs or origins
# (for example, https://example.com/app,http://localhost:3000)
FRONTEND_ORIGINS=

# Comma-separated DNS servers used to resolve domain names
DNS_SERVERS=1.1.1.1,1.0.0.1

# MongoDB connection URI and database name
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=ticflow

# Cryptographically secure random secret; at least 64 characters hex recommended
JWT_SECRET=
