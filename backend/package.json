{
  "name": "@ticflow/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\" --ignore-path ../.gitignore",
    "lint": "eslint . --max-warnings 0",
    "ts-check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -b",
    "release": "prettier --write \"**/*.{ts,js,json,md}\" --ignore-path ../.gitignore && eslint . && tsc -b",
    "preview": "bun dist/server.js"
  },
  "dependencies": {
    "@ticflow/shared": "workspace:*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0"
  }
}
