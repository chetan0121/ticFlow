{
  "name": "@ticflow/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,css,md}\" --ignore-path .gitignore",
    "lint": "eslint . --max-warnings 0",
    "ts-check": "tsc -b",
    "build": "tsc -b && vite build",
    "release": "prettier --write \"**/*.{ts,tsx,js,jsx,css,md}\" --ignore-path .gitignore && eslint . && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1"
  }
}
